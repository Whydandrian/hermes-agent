#################################################
# AI
# Model provider and API key configuration
#################################################

# Provider dan model diatur di config/config.yaml.
# Untuk Groq, config.yaml memakai custom provider (provider: custom:groq)
# yang menunjuk ke https://api.groq.com/openai/v1 dengan key_env: GROQ_API_KEY.

# Groq API key (get from https://console.groq.com/keys)
GROQ_API_KEY="your-groq-api-key-here"

# Alternatif provider lain (opsional):
# GOOGLE_API_KEY="your-google-api-key-here"       # Gemini
# OPENROUTER_API_KEY="your-openrouter-api-key-here"

#################################################
# Timezone
# System timezone setting
#################################################

# Timezone for the container (IANA timezone format)
TZ=Asia/Makassar

#################################################
# Dashboard
# Hermes web dashboard configuration
#################################################

# Enable (1) or disable (0) the Hermes web dashboard
HERMES_DASHBOARD=0

#################################################
# WhatsApp
# WhatsApp messaging channel configuration
#################################################

# Enable (true) or disable (false) WhatsApp integration
WHATSAPP_ENABLED=true

# WhatsApp operation mode: "bot" (dedicated number) or "self-chat"
WHATSAPP_MODE=bot

# Allowed WhatsApp users (* for all, or comma-separated phone numbers)
WHATSAPP_ALLOWED_USERS=*

#################################################
# Telegram
# Telegram bot channel configuration
#################################################

# Enable (true) or disable (false) Telegram integration
TELEGRAM_ENABLED=true

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Allowed Telegram users (comma-separated user IDs, leave empty for all)
TELEGRAM_ALLOWED_USERS=

#################################################
# Email
# IMAP/SMTP email channel configuration
#################################################

# Enable (true) or disable (false) Email integration
EMAIL_ENABLED=true

# Email provider type (e.g., imap)
EMAIL_PROVIDER=imap

# Email polling interval in seconds
EMAIL_POLL_INTERVAL=60

# Email address to monitor
EMAIL_ADDRESS=your-email@example.com

# Email account password or app-specific password
EMAIL_PASSWORD=your-email-password-here

# IMAP server hostname for incoming email
EMAIL_IMAP_HOST=imap.example.com

# SMTP server hostname for outgoing email
EMAIL_SMTP_HOST=smtp.example.com

# Allowed email senders (comma-separated addresses)
EMAIL_ALLOWED_USERS="allowed-email@example.com"

#################################################
# Logging
# Application logging configuration
#################################################

# Log verbosity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

#################################################
# Helpdesk API (dipakai oleh scripts/sync_knowledge.py di HOST via cron)
# Autentikasi: header X-API-Key + X-API-Secret.
# Skrip menulis hasil ke knowledges/synced/ yang di-mount ke container.
#################################################

# Kredensial (dipakai untuk kedua endpoint di bawah)
KNOWLEDGE_API_KEY=your-helpdesk-api-key-here
KNOWLEDGE_API_SECRET=your-helpdesk-api-secret-here

# Endpoint knowledge base
KNOWLEDGE_API_URL=https://helpdesk.itk.ac.id/api/external/knowledge-bases

# Endpoint service catalog
SERVICE_CATALOG_API_URL=https://helpdesk.itk.ac.id/api/external/service-catalog
